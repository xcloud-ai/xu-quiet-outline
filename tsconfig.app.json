{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES2022",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "isolatedModules": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": false,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src/**/*.ts"]
}
